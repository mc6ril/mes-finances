{
  "name": "finances-perso",
  "private": true,
  "version": "0.17.1",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-finances \"vitest run --config vitest.emulator.config.ts\"",
    "typecheck": "tsc -b",
    "format": "biome check --write .",
    "lint": "biome check ."
  },
  "dependencies": {
    "firebase": "13.4.0",
    "lucide-react": "1.77.0",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-router": "8.5.2",
    "recharts": "3.11.0",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "firebase-tools": "15.37.0",
    "idb": "8.0.4",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
