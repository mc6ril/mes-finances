# Configuration web Firebase (console Firebase → Paramètres du projet → Vos applications → Web).
# Copier ce fichier en .env.local (ignoré par git) et remplacer les valeurs.
# Sur Netlify : Site configuration → Environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mon-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mon-projet
VITE_FIREBASE_APP_ID=
